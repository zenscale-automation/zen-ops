# =====================================================================
#  Loom dashboard + keyed API.
#
#  ---- ADDING A DOMAIN LATER IS ONE LINE -----------------------------
#  Right now this serves plain HTTP on the instance's IP, because a
#  certificate cannot be issued for a bare IP address.
#
#  To switch to real HTTPS, do NOT edit this file. Create the DNS record
#  (loom.zenscale.in -> 3.6.46.119), then:
#
#      sudo sed -i 's/^LOOM_SITE=.*/LOOM_SITE=loom.zenscale.in/' /etc/loom-web.env
#      sudo systemctl restart caddy
#
#  Caddy then obtains a Let's Encrypt certificate over port 80, redirects
#  http->https, and renews it forever. Nothing else changes: same paths,
#  same API, same dashboard.
#  --------------------------------------------------------------------
#
#  LOOM_SITE defaults to ":80" (any host, plain HTTP). Set it to an IP or a
#  hostname and automatic HTTPS switches itself on.
# Clients connecting to a bare IP do NOT send SNI - RFC 6066 forbids an IP
# literal there - so Caddy has nothing to match a site block against and aborts
# the handshake with "internal error". Naming a default tells it which
# certificate to present when SNI is absent. Harmless when serving on :80, and
# when you move to a hostname set LOOM_DEFAULT_SNI to that name (or ignore it,
# since clients do send SNI for hostnames).
{
	default_sni {$LOOM_DEFAULT_SNI:3.6.46.119}

	# Let's Encrypt issues certificates for a bare IP ADDRESS, but only under
	# its "shortlived" profile (~160 h). That profile works for hostnames too,
	# so this covers both. Set LOOM_TLS_PROFILE=default once you use a hostname
	# if you would rather have the usual longer-lived certificate.
	#
	# Declared globally rather than in the site block on purpose: a site-level
	# `tls` block attaches a TLS connection policy, which is invalid when
	# LOOM_SITE is ":80" - and that would make reverting to plain HTTP fail.
	cert_issuer acme {
		profile {$LOOM_TLS_PROFILE:shortlived}
	}
}

{$LOOM_SITE::80} {
	encode gzip

	# Keyed API for the dashboard and any independent page.
	# The X-API-Key header still applies - Caddy only routes, it does not
	# authenticate. /api/data here reaches /data on the logger.
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8080
	}

	# ops-core: the config and admin APIs only, never its dashboards.
	#
	# Deliberately narrower than a blanket /ops/* proxy. ops-core also serves
	# /api/overview and /api/tickets/open with no key at all, and an operator page
	# at /admin — none of which should answer to the open internet. Naming the two
	# key-gated prefixes means adding an unauthenticated endpoint upstream cannot
	# silently publish it.
	#
	# Caddy only routes. Authentication is X-Admin-Key, checked by the application,
	# and it is required on reads as well as writes because the effective config
	# contains every person's mobile number.
	# Inbound WhatsApp replies, from PickyAssist. The provider signs nothing, so the
	# secret IS the path: unguessable, known only to PickyAssist's webhook setting and
	# this file. Rotating it is editing this one line.
	handle /hook/<HOOK_SECRET>/whatsapp {
		uri replace /hook/<HOOK_SECRET>/whatsapp /webhook/whatsapp
		reverse_proxy 127.0.0.1:8000
	}

	# Delivery reports from PickyAssist's Event Webhook — same secret-is-the-path
	# pattern as the message webhook, its own slug so either can rotate alone.
	handle /hook/<EVENT_HOOK_SECRET>/events {
		uri replace /hook/<EVENT_HOOK_SECRET>/events /webhook/events
		reverse_proxy 127.0.0.1:8000
	}

	handle /ops/api/admin/* {
		uri strip_prefix /ops
		reverse_proxy 127.0.0.1:8000
	}
	handle /ops/api/config/* {
		uri strip_prefix /ops
		reverse_proxy 127.0.0.1:8000
	}

	# The dashboard.
	handle_path /loom* {
		root * /var/www/loom
		file_server
	}

	# Bare / goes to the dashboard rather than a 404.
	handle {
		redir /loom/ 302
	}
}
