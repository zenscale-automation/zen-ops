# ops-core configuration. Copy to .env and fill in. .env is gitignored; this file is not,
# so never put a real credential here.

# ---- which department's rules to load -------------------------------------------
# REQUIRED, and deliberately has no default: a department baked into the core is the
# coupling the config layer exists to avoid, and guessing would let a misconfigured
# second deployment load the wrong plant's escalation rules. The process refuses to
# start without it.
OPS_DEPARTMENT=weaving
OPS_CONFIG_DIR=departments

# ---- database (shared MySQL; every table carries the prefix) ---------------------
OPS_DB_HOST=
OPS_DB_PORT=3306
OPS_DB_USER=
OPS_DB_PASSWORD=
OPS_DB_NAME=
# Keep this set. The app happily migrates a second, empty table set under a new prefix
# and starts from nothing, so changing it after first boot silently orphans your data.
OPS_TABLE_PREFIX=opscore_

# ---- serving --------------------------------------------------------------------
OPS_HOST=127.0.0.1
OPS_PORT=8000

# ---- the loom feed --------------------------------------------------------------
LOOM_API_KEY=
# Overrides source.yaml. Set it on the box to reach the API directly rather than through
# the public proxy.
LOOM_API_BASE_URL=https://3.6.46.119/api

# ---- sending ---------------------------------------------------------------------
# SHADOW MODE IS THE DEFAULT AND IS A DECISION, not the accident of a blank field. While
# it is true the full pipeline runs and every outbound message is written to
# logs/notifications.log instead of being sent. Turning it off with no provider
# credentials is refused at boot, because that combination writes pages to a log file and
# records them as delivered.
OPS_SHADOW_MODE=true

# WhatsApp via PickyAssist (WhatsApp Official, application 121).
PICKYASSIST_TOKEN=
PICKYASSIST_APPLICATION=121
PICKYASSIST_BASE_URL=https://app.pickyassist.com/api/v2
# Two templates, not one: the numbered reason question and the "still down, please
# attend" page have different shapes. A template parameter cannot contain newlines, so
# the rendered body cannot be passed as a single variable.
PICKYASSIST_PROMPT_TEMPLATE_ID=
PICKYASSIST_ESCALATION_TEMPLATE_ID=
# The hours-estimate question. Only optional while the roster is one person (the ask
# then always follows that person's own reply, which opens the free-text window).
# Required before anyone else is added, or a cold first ask fails permanently.
PICKYASSIST_ETA_TEMPLATE_ID=
PICKYASSIST_TEMPLATE_LANG=en

# Google Chat (used where somebody is reached in a space rather than on a phone).
GCHAT_WEBHOOK_BASE_URL=

# ---- inbound ---------------------------------------------------------------------
# Verifies X-Hub-Signature-256 on /webhook/whatsapp. Unset means unverified, which is
# acceptable only while nothing is proxied to that path.
WHATSAPP_APP_SECRET=

# ---- the admin and config APIs ---------------------------------------------------
# The single credential protecting the plant's phone book. Required for reads as well as
# writes; unset means writes are refused entirely. Generate with:
#   head -c 24 /dev/urandom | base64 | tr -d '=+/' | cut -c1-32
OPS_ADMIN_API_KEY=
